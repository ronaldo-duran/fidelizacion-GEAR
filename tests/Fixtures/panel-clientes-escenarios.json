            "purchases": 3,
            "sees_merchant_filter": true
        },
        {
            "role": "administrador_comercio",
            "comercio_nit": "800200200",
            "customers": ["marcela"],
            "ledger_of": { "marcela": { "movements": 1, "sum_equals_balance": false } },
            "purchases": 1,
            "sees_merchant_filter": false,
            "forbidden_customers": ["yeferson", "sin_compras"],
            "_reason": "decision 4: full balance and level, but only the movements of the merchant"
        }
    ],
    "adjustments": [
        {
            "_description": "A positive adjustment that crosses the oro threshold raises the level in the same request.",
            "customer": "marcela",
            "role": "administrador_grupo",
            "puntos": 1000,
            "motivo": "Compra registrada en papel durante una caída del sistema",
            "expected": {
                "accepted": true,
                "saldo_puntos": 1570,
                "nivel_por_puntos": "oro",
                "nivel_efectivo": "oro",
                "cambio_nivel": null,
                "_reason": "nivel_por_puntos goes up to oro; nivel_efectivo was already oro by the event, so there is no level change"
            }
        },
        {
            "_description": "A positive adjustment that raises the effective level writes the level change.",
            "customer": "yeferson",
            "role": "administrador_grupo",
            "puntos": 500,
            "motivo": "Compras de la sede nueva que no se registraron",
            "expected": {
                "accepted": true,
                "saldo_puntos": 585,
                "nivel_por_puntos": "plata",
                "nivel_efectivo": "plata",
                "cambio_nivel": { "anterior": "bronce", "nuevo": "plata", "motivo": "ascenso_ajuste" }
            }
        },
        {
            "_description": "A negative adjustment lowers the balance but never the level (only the nightly job does).",
            "customer": "marcela",
            "role": "administrador_grupo",
            "puntos": -100,
            "motivo": "Compra registrada dos veces",
            "expected": {
                "accepted": true,
                "saldo_puntos": 470,
                "nivel_por_puntos": "plata",
                "nivel_efectivo": "oro",
                "cambio_nivel": null,
                "_reason": "470 is below plata, but nivel_por_puntos stays until the nightly job (hard rule 3.6)"
            }
        },
        {
            "customer": "yeferson",
            "role": "administrador_grupo",
            "puntos": -86,
            "motivo": "Error de digitación",
            "expected": { "accepted": false, "error_field": "puntos", "saldo_puntos": 85 },
            "_reason": "the balance would go below zero"
        },
        {
            "customer": "yeferson",
            "role": "administrador_grupo",
            "puntos": 50,
            "motivo": "   ",
            "expected": { "accepted": false, "error_field": "motivo", "saldo_puntos": 85 }
        },
        {
            "customer": "yeferson",
            "role": "administrador_grupo",
            "puntos": 0,
            "motivo": "Sin cambio",
            "expected": { "accepted": false, "error_field": "puntos", "saldo_puntos": 85 }
        },
        {
            "customer": "marcela",
            "role": "administrador_comercio",
            "comercio_nit": "800200200",
            "puntos": 100,
            "motivo": "Intento sin permiso",
            "expected": { "accepted": false, "status": 403, "action_visible": false, "saldo_puntos": 570 }
        }
    ],
    "annulments": [
        {
            "_description": "The merchant administrator annuls a purchase of their merchant within the window.",
            "purchase": { "customer": "marcela", "comercio_nit": "800200200", "dias_atras": 3 },
            "role": "administrador_comercio",
            "comercio_nit": "800200200",
            "motivo": "El cliente devolvió el producto",
            "expected": { "action_visible": true, "accepted": true, "estado": "anulada", "reversa_puntos": -450 }
        },
        {
            "_description": "Out of the reversal window: no action and a rejection.",
            "purchase": { "customer": "marcela", "comercio_nit": "800100100", "dias_atras": 40 },
            "role": "administrador_grupo",
            "motivo": "Revisión tardía",
            "expected": { "action_visible": false, "accepted": false }
        },
        {
            "_description": "A purchase of another merchant: no action and a 403.",
            "purchase": { "customer": "yeferson", "comercio_nit": "800100100", "dias_atras": 1 },
            "role": "administrador_comercio",
            "comercio_nit": "800200200",
            "motivo": "Intento sin permiso",
            "expected": { "action_visible": false, "accepted": false, "status": 403 }
        },
        {
            "_description": "An annulment without a reason is rejected.",
            "purchase": { "customer": "yeferson", "comercio_nit": "800100100", "dias_atras": 1 },
            "role": "administrador_grupo",
            "motivo": "",
            "expected": { "action_visible": true, "accepted": false, "error_field": "motivo" }
        },
        {
            "_description": "An already annulled purchase offers no action.",
            "purchase": { "customer": "yeferson", "comercio_nit": "800100100", "dias_atras": 1, "estado": "anulada" },
