            "parallel_requests": 10,
            "setup": { "referencia_externa": "fac-2002", "monto": 45000, "customer": "andres" },
            "body": { "motivo": "Devolución en caja" },
            "expected_reversas": 1,
            "expected_reversa_puntos": -45,
            "expected_saldo": 470,
            "expected_estado": "anulada",
            "expected_status_counts": { "201": 1, "200": 9 }
        }
    ],
