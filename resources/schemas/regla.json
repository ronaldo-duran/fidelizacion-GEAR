{
    "_note": "JSON Schema (draft 2020-12) for the `definicion` column of `reglas`, per type. CLOSED schema: additionalProperties=false at every level, whitelist of keys and operators. Implements hard rule 3.8 of CLAUDE.md. No free-form expressions or evaluable strings: a condition is an object {campo, operador, valor}, never a string like \"monto > 50000\". The E3-01 validator applies the sub-schema that matches the rule `tipo`.",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://clubaponterivera.co/schema/regla.json",
    "title": "Definición de regla",
    "type": "object",
    "unevaluatedProperties": false,
    "required": ["tipo", "definicion"],
    "properties": {
        "tipo": {
            "enum": ["acumulacion", "niveles", "bonificacion", "bono_registro"]
        },
        "definicion": {
            "type": "object"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "tipo": {
                        "const": "acumulacion"
                    }
                }
            },
            "then": {
                "properties": {
                    "definicion": {
                        "$ref": "#/$defs/defAcumulacion"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "tipo": {
                        "const": "niveles"
                    }
                }
            },
            "then": {
                "properties": {
                    "definicion": {
                        "$ref": "#/$defs/defNiveles"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "tipo": {
                        "const": "bonificacion"
                    }
                }
            },
            "then": {
                "properties": {
                    "definicion": {
                        "$ref": "#/$defs/defBonificacion"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "tipo": {
                        "const": "bono_registro"
                    }
                }
            },
            "then": {
                "properties": {
                    "definicion": {
                        "$ref": "#/$defs/defBonoRegistro"
                    }
                }
            }
        }
    ],
    "$defs": {
        "nivel": {
            "enum": ["bronce", "plata", "oro", "diamante"]
        },
        "enteroPositivo": {
            "type": "integer",
            "minimum": 0
        },
        "operador": {
            "_note": "Operator whitelist. Structured comparisons only. Any operator outside this list is forbidden.",
            "enum": ["igual", "distinto", "mayor", "mayor_igual", "menor", "menor_igual", "en"]
        },
        "campoCondicion": {
            "_note": "Whitelist of fields a condition can use. Any field outside this list is forbidden.",
            "enum": ["monto", "categoria_slug", "comercio_id", "sede_id", "dia_semana", "hora"]
        },
        "condicion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["campo", "operador", "valor"],
            "properties": {
                "campo": {
                    "$ref": "#/$defs/campoCondicion"
                },
                "operador": {
                    "$ref": "#/$defs/operador"
                },
                "valor": {
                    "_note": "Integer (pesos or id), string (slug), or an array of those for the `en` operator. Never an object or an expression.",
                    "type": ["integer", "string", "array"],
                    "items": {
                        "type": ["integer", "string"]
                    }
                }
            }
        },
        "defAcumulacion": {
            "type": "object",
            "additionalProperties": false,
            "required": ["moneda_por_punto", "tasas_por_categoria", "vigencia_puntos_meses"],
            "properties": {
                "moneda_por_punto": {
                    "_note": "Integer pesos worth 1 base point. Confirmed by the client: $1.000.",
                    "type": "integer",
                    "minimum": 1
                },
                "tasas_por_categoria": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["categoria_slug", "puntos_por_unidad"],
                        "properties": {
                            "categoria_slug": {
                                "type": "string",
                                "minLength": 1
                            },
                            "puntos_por_unidad": {
                                "_note": "Points awarded for every `moneda_por_punto` spent in that category.",
                                "type": "integer",
                                "minimum": 0
                            }
                        }
                    }
                },
                "topes": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "puntos_por_transaccion": {
                            "type": ["integer", "null"],
                            "minimum": 1
                        },
                        "puntos_por_dia": {
                            "type": ["integer", "null"],
                            "minimum": 1
                        },
                        "puntos_por_mes": {
                            "type": ["integer", "null"],
                            "minimum": 1
                        }
                    }
                },
                "vigencia_puntos_meses": {
                    "_note": "Months points live before expiring. Confirmed by the client: 12.",
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "defNiveles": {
            "type": "object",
            "additionalProperties": false,
            "required": ["umbrales", "proteccion_meses", "avisos_dias_antes"],
            "properties": {
                "umbrales": {
                    "_note": "Minimum points for each level. Bronce is always 0. They must be strictly increasing. Confirmed by the client: Plata 500, Oro 1.500, Diamante 3.000.",
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["nivel", "umbral_puntos"],
                        "properties": {
                            "nivel": {
                                "$ref": "#/$defs/nivel"
                            },
                            "umbral_puntos": {
                                "$ref": "#/$defs/enteroPositivo"
                            }
                        }
                    }
                },
                "proteccion_meses": {
                    "_note": "Grace months before dropping a level. Confirmed by the client: 0 (no protection).",
                    "type": "integer",
                    "minimum": 0
                },
                "avisos_dias_antes": {
                    "_note": "Days in advance of each demotion notice. Confirmed by the client: [30, 7, 1]. Unique integers; the E3-01 validator checks the strictly decreasing order because JSON Schema cannot express it.",
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "integer",
                        "minimum": 0
                    }
                }
            }
        },
        "defBonificacion": {
            "_note": "Optional rule for extra points when structured conditions are met. Every condition must hold (AND). The multiplier applies to the transaction's base points.",
            "type": "object",
            "additionalProperties": false,
            "required": ["multiplicador", "condiciones"],
            "properties": {
                "multiplicador": {
                    "_note": "Integer factor on the base points. 2 = double. Integer so no decimals are introduced (hard rule 3.9).",
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 10
                },
                "condiciones": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 5,
                    "items": {
                        "$ref": "#/$defs/condicion"
                    }
                }
            }
        },
        "defBonoRegistro": {
            "_note": "Fixed points when a customer joins the program while the rule is in force (E3-06). The title is shown to the customer and never evaluated. Only one registration bonus can be in force at a time.",
            "type": "object",
            "additionalProperties": false,
            "required": ["puntos", "titulo"],
            "properties": {
                "puntos": {
                    "type": "integer",
                    "minimum": 1
                },
                "titulo": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                }
            }
        }
    }
}
