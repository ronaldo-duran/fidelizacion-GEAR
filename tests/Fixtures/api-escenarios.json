    "annulment": [
        {
            "_description": "Annul inside the window: the reversal exists and the purchase is annulled.",
            "setup": {
                "credential": "pos-rancho",
                "referencia_externa": "fac-5001",
                "monto": 45000,
                "customer": "andres",
                "days_ago": 29
            },
            "credential": "pos-rancho",
            "body": { "motivo": "Devolución en caja" },
            "expected_status": 200,
            "expected_estado": "anulada",
            "expected_reversa_puntos": -45
        },
        {
            "_description": "Annulling twice: the second answer is a replay without another reversal.",
            "setup": {
                "credential": "pos-rancho",
                "referencia_externa": "fac-5002",
                "monto": 45000,
                "customer": "andres",
                "already_annulled": true
            },
            "credential": "pos-rancho",
            "body": { "motivo": "Devolución en caja" },
            "expected_status": 200,
            "expected_replayed": true,
            "expected_reversas": 1
        },
        {
            "_description": "Outside the window the purchase does not change.",
