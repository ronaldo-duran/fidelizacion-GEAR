            "body": {
                "tipo_documento": "CC",
                "documento": "1012345678",
                "monto": 45000,
                "referencia_externa": "fac-1002"
            },
            "expected_status": 400,
            "expected_codigo": "idempotency_key_invalida",
            "expected_transacciones": 0
        },
        {
            "_description": "The same purchase sent twice: the second one is a replay with the same body and no new points.",
            "credential": "pos-rancho",
            "requests": [
                {
                    "idempotency_key": "3f1c2b9e-6a1d-4f7e-9c2a-1b8d7e6f5a40",
                    "body": {
                        "tipo_documento": "CC",
                        "documento": "1012345678",
                        "monto": 45000,
                        "referencia_externa": "FAC-1003"
                    },
                    "expected_status": 201,
                    "expected_replayed": false
                },
                {
                    "idempotency_key": "3f1c2b9e-6a1d-4f7e-9c2a-1b8d7e6f5a40",
                    "body": {
                        "tipo_documento": "CC",
                        "documento": "1012345678",
                        "monto": 45000,
                        "referencia_externa": "fac-1003"
                    },
                    "expected_status": 200,
                    "expected_replayed": true
                }
            ],
            "expected_transacciones": 1,
            "expected_puntos_otorgados": 45,
            "expected_saldo": 515
        },
        {
            "_description": "Same reference, different amount: conflict, nothing written.",
            "credential": "pos-rancho",
            "requests": [
                {
                    "idempotency_key": "new",
                    "body": {
                        "tipo_documento": "CC",
                        "documento": "1012345678",
                        "monto": 45000,
                        "referencia_externa": "fac-1004"
                    },
                    "expected_status": 201
                },
                {
                    "idempotency_key": "new",
                    "body": {
                        "tipo_documento": "CC",
                        "documento": "1012345678",
                        "monto": 46000,
                        "referencia_externa": "fac-1004"
                    },
                    "expected_status": 409,
                    "expected_codigo": "compra_en_conflicto"
                }
            ],
            "expected_transacciones": 1,
            "expected_saldo": 515
        },
        {
            "_description": "Same reference, different document: conflict.",
            "credential": "pos-rancho",
            "requests": [
                {
                    "idempotency_key": "new",
                    "body": {
                        "tipo_documento": "CC",
                        "documento": "1012345678",
                        "monto": 45000,
                        "referencia_externa": "fac-1005"
                    },
                    "expected_status": 201
                },
                {
                    "idempotency_key": "new",
                    "body": {
                        "tipo_documento": "PPT",
                        "documento": "B7K2M9Q4",
                        "monto": 45000,
                        "referencia_externa": "fac-1005"
                    },
                    "expected_status": 409,
                    "expected_codigo": "compra_en_conflicto"
                }
            ],
            "expected_transacciones": 1
        },
        {
            "_description": "The same reference in two merchants is two purchases.",
            "requests": [
                {
                    "credential": "pos-rancho",
                    "idempotency_key": "new",
                    "body": {
                        "tipo_documento": "CC",
                        "documento": "1012345678",
                        "monto": 20000,
                        "referencia_externa": "fac-1006"
                    },
                    "expected_status": 201
                },
                {
                    "credential": "pos-heladeria",
                    "idempotency_key": "new",
                    "body": {
                        "tipo_documento": "CC",
                        "documento": "1012345678",
                        "monto": 20000,
                        "referencia_externa": "fac-1006"
                    },
                    "expected_status": 201
                }
            ],
            "expected_transacciones": 2,
            "expected_saldo": 510
        }
    ],
    "concurrency": [
        {
            "_description": "Ten simultaneous POS retries of the same purchase (criterion of issue #25).",
            "credential": "pos-rancho",
            "parallel_requests": 10,
            "body": {
                "tipo_documento": "CC",
                "documento": "1012345678",
                "monto": 45000,
                "referencia_externa": "fac-2001"
            },
            "expected_transacciones": 1,
            "expected_movimientos": 1,
            "expected_saldo": 515,
            "expected_status_counts": { "201": 1, "200": 9 }
        },
        {
            "_description": "Ten simultaneous deliveries with the same Idempotency-Key.",
            "credential": "pos-rancho",
            "parallel_requests": 10,
            "idempotency_key": "9b6f0c1e-2d4a-4c8b-8e1f-7a3d5c2b1e90",
            "delivery": "by_document",
            "expected_redenciones": 1,
            "expected_status_counts": { "201": 1, "200": 9 }
        },
        {
            "_description": "Ten simultaneous annulments of the same purchase, each with its own Idempotency-Key: one reversal; the API answers 200 to all and nine of them carry Idempotent-Replayed (counted here as 200; the one that annulled as 201).",
