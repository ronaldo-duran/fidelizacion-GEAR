    "cases": [
        {
            "_description": "Registered customer, restaurant purchase of $85.000 with the double bonus: two accrual movements, one per rule.",
            "_e4_01_criterion": "a bonus leaves one movement per rule",
            "cliente": {
                "documento": "1010101010",
                "saldo_puntos": 0,
                "nivel_efectivo": "bronce"
            },
            "purchase": {
                "comercio_id": 1,
                "sede_id": 11,
                "monto": 85000,
                "referencia_externa": "caja-0001"
            },
            "expected_estado": "acreditada",
            "expected_movimientos": [
                {
                    "tipo": "acumulacion",
                    "puntos": 85,
                    "regla_codigo": "acumulacion-base",
                    "regla_version": 1,
                    "vigencia_hasta": "hoy+12m"
                },
                {
                    "tipo": "acumulacion",
                    "puntos": 85,
                    "regla_codigo": "doble-restaurante",
                    "regla_version": 1,
                    "vigencia_hasta": "hoy+12m"
                }
