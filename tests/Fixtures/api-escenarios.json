{
    "_note": "Scenarios for E9-01 (public API for merchants). Today is Friday 2026-11-06 15:00 in America/Bogota. Merchants, branches and rules are the ones in compras-escenarios.json (merchant 1 restaurant with branches 11 active and 12 inactive, merchant 2 ice cream with branch 21, merchant 5 inactive with branch 51); only the rule `acumulacion-base` is active here, so 1 point per $1.000. Granted values and benefit states come from redencion-escenarios.json and are not repeated. Every credential belongs to one branch (decision 1 of the spec). Request fields use the database column names. `idempotency_key` values are UUIDs; `\"new\"` means a fresh UUID per request. Values the client has not confirmed carry \"_assumption\": true.",
    "today": "2026-11-06 15:00:00",
    "settings": {
        "requests_per_minute": {
            "value": 120,
            "_assumption": true,
            "_source": "decision 7 of the spec: general limit per credential"
        },
        "customer_lookups_per_minute": {
            "value": 60,
            "_assumption": true,
            "_source": "decision 7 of the spec: operations 1 and 2 per credential"
        },
        "rotation_grace_hours": {
            "value": 24,
            "_assumption": true,
            "_source": "business rule 4: the old token keeps working while the POS switches"
        },
        "max_amount": {
            "value": 999999999999,
            "_assumption": true,
            "_source": "business rule 9: whole pesos, room for property purchases"
        },
        "annul_window_days": {
            "value": 30,
            "_source": "decision 4 of the spec: the ledger reversal window, config puntos.reversal_window_days"
        },
        "idempotency_key_format": { "value": "uuid", "_source": "decision 3 of the spec" }
    },
    "abilities": {
        "GET /api/v1/clientes": "clientes:leer",
        "GET /api/v1/clientes/beneficios": "clientes:leer",
        "POST /api/v1/compras": "compras:registrar",
        "GET /api/v1/compras/{referencia_externa}": "compras:registrar",
        "POST /api/v1/compras/{referencia_externa}/anulacion": "compras:anular",
        "GET /api/v1/codigos/{codigo}": "beneficios:redimir",
        "POST /api/v1/redenciones": "beneficios:redimir"
    },
    "credentials": [
        {
            "key": "pos-rancho",
            "comercio_id": 1,
            "sede_id": 11,
            "abilities": ["clientes:leer", "compras:registrar", "compras:anular", "beneficios:redimir"]
        },
        {
            "key": "pos-heladeria",
            "comercio_id": 2,
            "sede_id": 21,
            "abilities": ["clientes:leer", "compras:registrar", "compras:anular", "beneficios:redimir"]
        },
        {
            "key": "pos-rancho-solo-compras",
            "comercio_id": 1,
            "sede_id": 11,
            "abilities": ["compras:registrar"]
        },
        {
            "key": "pos-rancho-sede-inactiva",
            "comercio_id": 1,
            "sede_id": 12,
            "abilities": ["compras:registrar"]
        },
        {
            "key": "pos-comercio-inactivo",
            "comercio_id": 5,
            "sede_id": 51,
            "abilities": ["compras:registrar"]
        }
    ],
    "customers": [
        {
            "key": "andres",
            "tipo_documento": "CC",
            "documento": "1012345678",
            "nombre_completo": "Andrés Felipe Rojas",
            "celular": "3001234567",
            "email": "andres@example.com",
            "fecha_nacimiento": "1990-10-29",
            "saldo_puntos": 470,
