            "expected_status": 403,
            "expected_codigo": "sin_permiso"
        },
        {
            "_description": "A credential of an inactive branch.",
            "credential": "pos-rancho-sede-inactiva",
            "request": "GET /api/v1/compras/fac-0001",
            "expected_status": 403,
            "expected_codigo": "sede_inactiva"
        },
        {
            "_description": "A credential of an inactive merchant.",
            "credential": "pos-comercio-inactivo",
            "request": "GET /api/v1/compras/fac-0001",
            "expected_status": 403,
            "expected_codigo": "comercio_inactivo"
        }
    ],
    "idempotency": [
        {
            "_description": "A POST without Idempotency-Key is rejected before touching the database.",
