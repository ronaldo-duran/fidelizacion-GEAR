    "searches": [
        { "tipo_documento": "CC", "term": "1023 456 789", "expected": ["marcela"] },
        { "tipo_documento": "CE", "term": "1023456789", "expected": ["sin_compras"] },
        { "tipo_documento": "PPT", "term": "a1b2 c3d4", "expected": ["yeferson"] },
        { "tipo_documento": "CC", "term": "A1B2C3D4", "expected": [] },
        { "term": "marcela", "expected": ["marcela"], "_reason": "name search ignores case on both engines" },
        { "term": "GÓMEZ", "expected": ["marcela"] }
    ],
    "visibility": [
        {
            "role": "administrador_grupo",
            "customers": ["marcela", "yeferson", "sin_compras"],
