    "authentication": [
        {
            "_description": "No Authorization header.",
            "token": "none",
            "expected_status": 401,
            "expected_codigo": "no_autenticado"
        },
        {
            "_description": "A token that does not exist.",
            "token": "unknown",
            "expected_status": 401,
            "expected_codigo": "no_autenticado"
        },
        {
            "_description": "A revoked credential stops working on the next request.",
            "credential": "pos-rancho",
            "token": "revoked",
            "expected_status": 401,
            "expected_codigo": "no_autenticado"
        },
        {
            "_description": "After a rotation, the old token still works inside the grace window.",
            "credential": "pos-rancho",
            "token": "rotated",
            "hours_after_rotation": 23,
            "expected_status": 200
        },
        {
            "_description": "After the grace window, only the new token works.",
            "credential": "pos-rancho",
            "token": "rotated",
            "hours_after_rotation": 25,
            "expected_status": 401,
            "expected_codigo": "no_autenticado"
        },
        {
            "_description": "The new token of a rotation works right away.",
            "credential": "pos-rancho",
            "token": "rotation_new",
            "hours_after_rotation": 0,
            "expected_status": 200
        },
        {
            "_description": "A credential without the ability of the operation.",
