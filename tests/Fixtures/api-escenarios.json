    "redemption": [
        {
            "_description": "By code: the code is checked first and then delivered with the same key twice.",
            "credential": "pos-rancho",
            "delivery": "by_code",
            "steps": [
                { "request": "GET /api/v1/codigos/{codigo}", "expected_status": 200, "expected_resultado": "valido" },
                {
                    "request": "POST /api/v1/redenciones",
                    "idempotency_key": "c4a7e2d1-9b3f-4a6e-8d2c-5f1b0e9a7c62",
                    "expected_status": 201,
                    "expected_fields": ["valor_otorgado_cop", "beneficio_id", "sede_id", "referencia", "created_at"]
                },
                {
                    "request": "POST /api/v1/redenciones",
                    "idempotency_key": "c4a7e2d1-9b3f-4a6e-8d2c-5f1b0e9a7c62",
                    "expected_status": 200,
                    "expected_replayed": true
                },
                { "request": "GET /api/v1/codigos/{codigo}", "expected_status": 200, "expected_resultado": "ya_usado" }
