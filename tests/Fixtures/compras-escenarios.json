        {
            "id": 1,
            "categoria_slug": "restaurante",
            "activo": true,
            "sedes": [
                {
                    "id": 11,
                    "activa": true
                },
                {
                    "id": 12,
                    "activa": false
                }
            ]
        },
        {
            "id": 2,
